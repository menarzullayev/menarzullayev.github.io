{
  "name": "menarzullayev-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive profile site: project graph, live statistics, human and agent views (EN, UZ, RU).",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "dev": "npm run prepare-data && vite",
